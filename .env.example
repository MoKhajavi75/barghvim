# Listen address. Takes precedence over PORT.
ADDR=:8080

# Port shorthand, used when ADDR is unset.
# PORT=8080

# Log level: debug, info, warn, error.
LOG_LEVEL=info

# How many days ahead to request outages for (1-60).
OUTAGE_WINDOW_DAYS=7

# Upstream برق من endpoint. Override only for testing.
# UPSTREAM_URL=https://uiapi2.saapa.ir/api/ebills/PlannedBlackoutsReport
