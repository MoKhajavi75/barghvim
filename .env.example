# Listen address. Takes precedence over PORT.
ADDR=:8080

# Port shorthand, used when ADDR is unset.
# PORT=8080

# Log level: debug, info, warn, error.
LOG_LEVEL=info

# How long a fetched outage report is reused before refetching (1m-168h).
# Outages are announced one to seven days ahead, so a few hours of staleness
# costs no useful warning and saves a lot of upstream calls.
CACHE_TTL=6h

# Upstream call allowance per hour (1-20). The API answers 429 past 20 an hour
# and counts per source IP, so the whole service shares one allowance. The
# default holds two back as headroom for retries.
UPSTREAM_CALLS_PER_HOUR=18

# Upstream outage-map endpoint. Override only for testing.
# UPSTREAM_URL=https://shahab.tbtb.ir/public/map/v2/GetOutagesListByBillId
